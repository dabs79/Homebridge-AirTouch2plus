{
  "name": "homebridge-airtouch2plus",
  "displayName": "AirTouch 2+",
  "version": "1.1.0",
  "description": "Homebridge plugin for the Polyaire AirTouch 2+ ducted AC controller (firmware API port 9200).",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "homebridge": ">=1.6.0 || ^2.0.0-beta.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "airtouch",
    "airtouch2plus",
    "polyaire",
    "ducted",
    "air conditioning",
    "hvac"
  ],
  "devDependencies": {
    "@types/node": "^20.12.0",
    "homebridge": "^1.8.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0"
  }
}
