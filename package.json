{
  "name": "homebridge-airtouch2plus",
  "displayName": "AirTouch 2+",
  "version": "1.5.0",
  "description": "Homebridge plugin for the Polyaire AirTouch 2+ ducted AC controller (firmware API port 9200).",
  "license": "MIT",
  "author": "dabs79 (https://github.com/dabs79)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dabs79/Homebridge-AirTouch2plus.git"
  },
  "bugs": {
    "url": "https://github.com/dabs79/Homebridge-AirTouch2plus/issues"
  },
  "homepage": "https://github.com/dabs79/Homebridge-AirTouch2plus#readme",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "homebridge": ">=1.6.0 || ^2.0.0-beta.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "airtouch",
    "airtouch2plus",
    "polyaire",
    "ducted",
    "air conditioning",
    "hvac"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "homebridge": "^1.11.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
